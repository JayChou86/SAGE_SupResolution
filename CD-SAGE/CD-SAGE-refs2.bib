@article{liuFullDuplexDirectionalMAC2022,
  title = {A Full-Duplex Directional {{MAC}} Framework for Underwater Acoustic Sensor Networks},
  author = {Liu, Qipei and Qiao, Gang and Mazhar, Suleman and Liu, Songzuo and Lou, Yi},
