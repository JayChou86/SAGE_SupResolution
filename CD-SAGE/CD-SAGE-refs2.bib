@article{liDolphinWhistleSignal2025,
  title = {Dolphin Whistle Signal Enhancement Using Nonconvex Time--Frequency Regularized Overlapping Group Shrinkage in Warm Shallow Water},
  author = {Li, Lei and Liu, Songzuo and Cui, Xuerong and Wang, Qian and Qiao, Gang},
  year = 2025,
  month = jan,
  journal = {IEEE Sensors Journal},
  volume = {25},
  number = {2},
  pages = {2949--2962},
  issn = {1530-437X, 1558-1748, 2379-9153},
  doi = {10.1109/JSEN.2024.3496737},
  abstract = {Enhancing dolphin whistle signals is a crucial preprocessing step in underwater passive acoustic monitoring (PAM), aimed at effectively improving the quality of collected signals. In warm shallow water environments, the presence of snapping shrimp noise causes typical underwater impulsive interference, significantly reducing the signal-to-noise ratio (SNR) of the received dolphin whistle signals and weakening the effectiveness of PAM systems. To address this issue, we propose a whistle enhancement algorithm based on nonconvex time--frequency (t--f) regularized overlapping group shrinkage (NCTFROGS). This algorithm leverages the group and sparse characteristics of whistle signals in the t--f spectrogram, defining the total cost function as a combination of sparse group shrinkage with t--f weighting and a nonconvex penalty function. In this framework, t--f weights are used to more effectively eliminate impulsive noise interference, while nonconvex functions promote a sparser solution in the reconstructed whistle signals. Finally, assuming that the cost function is strictly convex, we iteratively solve for the pure whistle signal using a method based on constructing auxiliary functions. Applied to whistle signals emitted by two individual Southern bottlenose dolphins, the algorithm demonstrates satisfactory enhancement effects under various types and SNRs of snapping shrimp impulsive noise interference.},
  langid = {english},
  keywords = {Dolphins,Group-sparsity reconstruction,Indexes,Interference,Monitoring,Noise,Noise measurement,Probability density function,Sensors,Spectrogram,Time-frequency analysis,underwater impulsive interference,underwater passive acoustic monitoring (PAM),whistle signal enhancement}
}

