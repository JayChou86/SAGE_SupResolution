@inproceedings{qingAcousticPropagationInvestigation2018,
  title = {Acoustic Propagation Investigation of a Dolphin Echolocation Pulse at Water-Sediment Interface Using Finite Element Model},
  booktitle = {2018 {{OCEANS}} - {{MTS}}/{{IEEE Kobe Techno-Oceans}} ({{OTO}})},
