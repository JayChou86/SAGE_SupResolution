@article{10947185,
  title = {Resource Allocation for Underwater Acoustic Sensor Networks with Partial Spectrum Sharing: {{When}} Optimization Meets Deep Reinforcement Learning},
  shorttitle = {Resource Allocation for Underwater Acoustic Sensor Networks with Partial Spectrum Sharing},
  author = {Tang, Rui and Zhang, Ruizhi and Xu, Yongjun and Liu, Chuan and Huang, Chongwen and Yuen, Chau},
  year = 2025,
  month = jun,
  journal = {IEEE Transactions on Network and Service Management},
  volume = {22},
  number = {3},
  pages = {2715--2730},
  issn = {1932-4537, 2373-7379},
  doi = {10.1109/TNSM.2025.3556498},
  abstract = {To utilize the limited acoustic spectrum while combating the harsh underwater propagation, we incorporate partial spectrum sharing into an underwater acoustic sensor network and aim to maximize the minimum data collection rate among all underwater sensor nodes through joint power allocation and spectrum assignment. To cope with the non-convex optimization problem, we propose a Hybrid Model-based and Data-based Resource Allocation (HMDRA) scheme: 1) Under any given spectrum assignment strategy, we analyze the impact of the partial spectrum sharing and imperfect successive interference cancellation on baseband signal processing, and formulate a power allocation problem that is solved by the bisection method and Lagrange dual theory. 2) Based on the optimal power allocation strategy, the gradient-free genetic algorithm (GA) is first adopted to approach the optimal solution of the model-less spectrum assignment problem by nearly enumerating the solution space. To reduce complexity, we further propose a deep reinforcement learning (DRL)-based algorithm and obtain an efficient solution by traversing a deep neural network-based policy learned from the training stage. Simulation results show that compared with the GA-based algorithm, the average execution time of the DRL-based algorithm is substantially reduced by 5 orders of magnitude to 0.7076 seconds at the cost of approximately 6 percent performance loss.},
  langid = {english},
  keywords = {Approximation algorithms,Bit rate,deep reinforcement learning,Inference algorithms,Interference cancellation,NOMA,Optimization,optimization theory,partial spectrum sharing,power allocation,Resource management,Signal processing algorithms,spectrum assignment,Training,Underwater acoustic sensor network,Underwater acoustics}
}

@article{11048430,
  title = {Bidirectional Joint Iterative {\emph{L}}{\textsubscript{1}} -{{RLS}} Estimation for Single-Carrier Underwater Acoustic Communication: {{Algorithm}} and Undersea Experimental Results},
  shorttitle = {Bidirectional Joint Iterative L1-{{RLS}} Estimation for Single-Carrier Underwater Acoustic Communication},
  author = {Zhu, Zhengliang and Yang, Degui and Zhang, Junchao and Jiang, Weihua and Wu, Fei-Yun},
  year = 2025,
  month = aug,
  journal = {IEEE Sensors Journal},
  volume = {25},
  number = {15},
  pages = {28643--28652},
  issn = {1530-437X, 1558-1748, 2379-9153},
  doi = {10.1109/JSEN.2025.3576580},
  abstract = {Enhancing the performance of single-carrier underwater acoustic (UWA) communication systems necessitates the development of accurate channel estimation techniques within the receiver. Among various approaches, the recursive least squares (RLS)-based channel estimation method has been extensively employed due to its rapid convergence and robust tracking capabilities. Over time, numerous enhancements have been incorporated into the RLS framework to further improve channel estimation performance for UWA systems. In this article, a novel bidirectional joint iterative l{$_1$} -RLS (Bi-Ji- l{$_1$} -RLS) algorithm is proposed to optimize channel estimation for single-carrier UWA communication systems. The proposed algorithm exploits bidirectional diversity and the inherent sparsity of UWA channels to achieve performance improvements. A comprehensive transient analysis is developed, jointly considering the bidirectional estimation mechanism and the l{$_1$} -norm constraint, which elucidates the operational behaviors and confirms the advantages of the Bi-Ji- l{$_1$} -RLS algorithm over the conventional l{$_1$} -RLS approaches. Simulation results further validate the theoretical analysis, demonstrating enhanced estimation accuracy. Moreover, experimental results obtained from undersea trials substantiate the practical effectiveness of the proposed algorithm, highlighting its moderate superiority over existing techniques in real-world UWA communication scenarios. Specifically, the proposed algorithm achieves the minimum bit error rate (BER) of 0.0832\% and the maximum output signal-to-noise ratio (OSNR) of 12.6024 dB.},
  langid = {english},
  keywords = {Accuracy,Adaptive filtering algorithm,bidirectional joint iterative algorithm,Channel estimation,Communication systems,Estimation,Iterative algorithms,Receivers,recursive least squares (RLS),Symbols,Transient analysis,transient performance analysis,underwater acoustic (UWA) communication,Underwater acoustics,Vectors}
}

@inproceedings{11104393,
  title = {A Comparison of the Multicarrier Modulations in Underwater Acoustic Channels},
  booktitle = {{{OCEANS}} 2025 {{Brest}}},
  author = {Liang, Duanci and Li, Wei and Guo, Rongrong},
  year = 2025,
  month = jun,
  pages = {1--8},
  doi = {10.1109/OCEANS58557.2025.11104393},
  abstract = {Recently, several new Multicarrier Modulation (MCM) techniques have been developed for next-generation wireless communications, particularly in high-mobility environments. Among these, Orthogonal Time Frequency Space (OTFS), Orthogonal Time Sequence Multiplexing (OTSM), Affine Frequency Division Multiplexing (AFDM), and Orthogonal Chirp Division Multiplexing (OCDM) have gained significant attention due to their excellent performance in time-varying and doubly spread channels. Underwater acoustic (UWA) channel is considered as one of the most challenging communication channels due to its strong time-varying and doubly-spread effect, which motivates the application of these MCM techniques to UWA communications. However, performance comparison of these techniques in the context of UWA channels remains scarce. In this paper, we compare the performance of AFDM, OCDM, OTFS, OTSM, and OFDM over both real and generated UWA channels. The results show that OFDM experiences significant performance degradation in both real and generated UWA channels. When parameters are properly adjusted, AFDM outperforms OCDM in terms of Bit Error Rate (BER), while OTFS and OTSM achieve the lowest BER.},
  langid = {english},
  keywords = {AFDM,Bit error rate,Code division multiplexing,Degradation,Modulation,Multicarrier modulation,OCDM,OFDM,OTFS,OTSM,Signal detection,Simulation,Underwater acoustics,UWA communications,Watermarking,Wireless communication}
}

@inproceedings{11104680,
  title = {Efficient Symbol Detection via Beamforming Preprocessing for {{OTFS}} Underwater Acoustic Communications},
  booktitle = {{{OCEANS}} 2025 {{Brest}}},
  author = {Zhang, Mingyuan and Tao, Jun and Liu, Changxin},
  year = 2025,
  month = jun,
  pages = {1--5},
  doi = {10.1109/OCEANS58557.2025.11104680},
  abstract = {Orthogonal time frequency space (OTFS) modulation has attracted considerable attention in underwater acoustic (UWA) communications due to its inherent advantages under time-varying channels. In this paper, we propose an efficient symbol detection scheme via beamforming preprocessing for OTFS UWA systems employing a receive array. The beamforming is performed in the time-frequency domain, and it brings array gain as well as complexity reduction. The beamformed signal was transformed to the delay-Doppler domain, where a direct adaptive equalizer (DAE) is adopted to recover transmitted symbols. Simulation and experimental results verified the advantages of the proposed beamforming-based multichannel DAE (BF-DAE) over existing solutions.},
  langid = {english},
  keywords = {Adaptive equalizers,Array signal processing,Arrays,Beamforming,Complexity theory,Direct Adaptive Equalizer (DAE),Modulation,Oceans,Orthogonal Time Frequency Space (OTFS),Symbols,Time-frequency analysis,Time-varying channels,Underwater Acoustic (UWA) Communication,Underwater acoustics}
}

@inproceedings{11104714,
  title = {Improved Frequency-Domain Equalization via Noise Whitening for Single-Carrier Underwater Acoustic Communications},
  booktitle = {{{OCEANS}} 2025 {{Brest}}},
  author = {Qian, Wenqing and Tao, Jun and Liu, Changxin},
  year = 2025,
  month = jun,
  pages = {1--5},
  doi = {10.1109/OCEANS58557.2025.11104714},
  abstract = {Frequency-domain equalization (FDE) has been proved as an efficient equalization scheme for single-carrier underwater acoustic (UWA) communications, especially under benign channel conditions. In existing FDE designs, white noise assumption is generally adopted to simplify the implementation, even though actual noise in UWA communications is usually colored. Such a discrepancy incus potential performance loss. To address this issue, we propose an improved FDE scheme via noise whitening preprocessing. The whitening filter is designed through a factorization of estimated noise power spectrum. The improved FDE scheme has been verified by real data collected in an at-sea UWA communication experiment. It showed that, in light of noise whitening, extra performance gain was achieved for the improved FDE scheme as compared with a conventional scheme using white noise assumption.},
  langid = {english},
  keywords = {Colored noise,Frequency-domain analysis,frequency-domain equalization (FDE),Noise,Oceans,Performance gain,underwater acoustic (UWA) communications,Underwater acoustics,White noise,whitening filter}
}

@article{11130177,
  title = {Reinforcement Learning-Based Virtual Time Compressed Mirror for Underwater Acoustical Channel Equalization Based on Main Path to Side Path Ratio Criterion},
  author = {Guo, Rongrong and Li, Wei and Zhang, Qinyu and Ma, Lu},
  year = 2025,
  month = oct,
  journal = {IEEE Journal of Oceanic Engineering},
  volume = {50},
  number = {4},
  pages = {2490--2502},
  issn = {0364-9059, 1558-1691, 2373-7786},
  doi = {10.1109/JOE.2025.3590116},
  abstract = {Underwater acoustical (UWA) channels exhibit severe multipath propagation and long delay spreads, resulting in serious intersymbol interference in communications. In this article, we propose a virtual time compressed mirror (VTCM), a sparse adaptive equalizer, and its reinforcement learning (RL)-based version, RLVTCM. VTCM can compress the time-spread channel with a virtual mirror based on sparse estimation, while RLVTCM enhances this approach by exploiting RL to adjust VTCM's parameter-setting according to the UWA environment adaptively. In addition, we introduce a main path to side path ratio (MSR) criterion to evaluate the equalization performance in multipath channels before demodulation. Simulations and experiments demonstrate that both VTCM and RLVTCM significantly improve communication performance. MSR consistently reflects symbol error rate performance.},
  langid = {english},
  keywords = {Channel equalization,Channel estimation,Compressed sensing,Computational complexity,Computational modeling,Delays,Demodulation,Equalizers,main path to side path ratio (MSR),Mirrors,Multipath channels,Receivers,Reinforcement learning,reinforcement learning (RL),Signal to noise ratio,underwater acoustical (UWA) communications,Underwater acoustics,virtual time compressed mirror (VTCM)}
}

@article{11130666,
  title = {Enhancing Network Reliability in {{UASNs}}: {{A}} Collision-Aware Critical Node Identification Algorithm},
  shorttitle = {Enhancing Network Reliability in Uasns},
  author = {Song, Shanshan and Wu, Xiujuan and Xu, Cangzhu and Pan, Miao and Han, Guangjie},
  year = 2026,
  month = jan,
  journal = {IEEE Transactions on Mobile Computing},
  volume = {25},
  number = {1},
  pages = {1398--1413},
  issn = {1536-1233, 1558-0660, 2161-9875},
  doi = {10.1109/TMC.2025.3600460},
  abstract = {Critical node identification is essential for Underwater Acoustic Sensor Networks (UASNs) to ensure network connectivity and reliability. Existing methods identify critical nodes by evaluating their contributions to network connectivity and node communication count. However, these methods identify critical nodes inaccurately due to neglecting the influence of packet collisions, leading to unreliable network. Packet collisions disrupt connected links and cause communication failures, resulting in unreliable network connectivity and improper communication count. To this end, we propose the Collision-Aware Critical Node Identification Algorithm (CCNIA), which accounts for the impact of packet collisions to improve the accuracy of critical node identification and enhance network reliability. CCNIA identifies critical nodes with high connectivity, large collision probability, and heavy network load, through building the three following interdependent models. Specifically, Topological Connectivity Model (TCM) evaluates link reachability by analyzing connectivity and density within a node's local network. Based on TCM, Collision Probability Model (CPM) further ensures packet reliability by quantifying the impact of packet collisions on critical node identification. Through CPM's reliable packet transmissions, Network Load Model (NLM) assesses network efficiency by analyzing node occurrence count within global end-to-end communication paths. Experiments show that CCNIA outperforms existing methods across diverse network configurations, enhancing network reliability in terms of packet delivery ratio, delay, and energy efficiency.},
  langid = {english},
  keywords = {Accuracy,Collision probability,Computer network reliability,critical node identification,Data mining,Energy efficiency,Load modeling,Mobile computing,reliability,Reliability,Reliability engineering,Telecommunication traffic,Training,underwater acoustic sensor networks (UASNs)}
}

@article{11185302,
  title = {Differential Feature-Based Physical Layer Authentication for Underwater Acoustic Sensor Networks},
  author = {Zhao, Ruiqin and Li, Jinxia and Shi, Ting and Wang, Haiyan},
  year = 2025,
  month = nov,
  journal = {IEEE Sensors Journal},
  volume = {25},
  number = {21},
  pages = {40834--40848},
  issn = {1530-437X, 1558-1748, 2379-9153},
  doi = {10.1109/JSEN.2025.3613742},
  abstract = {Underwater acoustic sensor networks (UASNs) play a critical role in underwater communication and mission execution. However, their open nature and the dynamics of underwater acoustic channels (UACs) make them highly susceptible to spoofing attacks, posing severe security threats. Physical layer authentication (PLA) offers a promising defense by exploiting the unique characteristics of UACs, which are difficult to replicate. Nevertheless, most existing PLA schemes rely on static or statistical features that degrade significantly under time-varying ocean environments. To address this challenge, we propose a robust PLA (RPLA) scheme based on differential features designed for dynamic underwater channels. RPLA adopts a differential feature extraction method that compares each channel impulse response (CIR) with historical CIRs from the same link to quantify temporal variations. Five multidimensional differential features are extracted to capture fine-grained link variability and highlight distinctions between legitimate and adversarial links. These features are used to construct labeled training samples, which are then fed into an authentication model to enable robust and adaptive classification under time-varying underwater conditions. Extensive evaluations using both simulated and sea trial CIR datasets demonstrate that RPLA achieves high authentication accuracy and robust performance, significantly improving resistance to spoofing attacks. This work presents a practical and effective approach to enhancing physical layer security in dynamic underwater communication environments.},
  langid = {english},
  keywords = {Authentication,Channel impulse response,Delays,Differential features,Feature extraction,Oceans,Physical layer,physical layer authentication (PLA),Reliability,Security,underwater acoustic sensor network (UASN),Underwater acoustics,Vehicle dynamics}
}

@article{11223900,
  title = {An Inter-Doppler Interference-Constrained {{OC-DFE}} for {{OTFS}} in {{UWA}} Communications},
  author = {Yang, Yang and Ma, Lu and Seet, Boon-Chong},
  year = 2026,
  journal = {IEEE Wireless Communications Letters},
  volume = {15},
  pages = {290--294},
  issn = {2162-2337, 2162-2345},
  doi = {10.1109/LWC.2025.3624208},
  abstract = {Orthogonal Time Frequency Space (OTFS) modulation presents a promising approach for underwater acoustic (UWA) communication. This letter proposes an iterative decision feedback equalizer based on optimal combining (OC) for UWA-OTFS systems, addressing challenges posed by the full-matrix channel characteristics in the delay-Doppler domain. The proposed detector maximizes the signal-to-interference-plus-noise ratio of the combined signal. Furthermore, by introducing inter-Doppler interference depth, the OC detector dynamically constrains the number of combining terms. Simulation results demonstrate that the proposed detector effectively balances bit error rate performance with computational complexity.},
  langid = {english},
  keywords = {adaptive,Delays,detector,Detectors,DFE,Diversity reception,Doppler effect,Doppler factor,Indexes,Interference,interference correlation,Matrix converters,OC,OTFS,Signal to noise ratio,Symbols,UWA,Vectors}
}

@article{11309736,
  title = {Underwater Acoustic Spectrum Sensing Algorithm Based on Personalized Federated Learning and {{RepViG}}},
  author = {Wang, Kai and Fang, Jun and Zhang, Liliang and Xiao, Ping and Cai, Bixin and Zheng, Gengfeng and Xu, Lingwei and Gulliver, T. Aaron},
  year = 2026,
  month = mar,
  journal = {IEEE Internet of Things Journal},
  volume = {13},
  number = {6},
  pages = {11649--11660},
  issn = {2327-4662, 2372-2541},
  doi = {10.1109/JIOT.2025.3646620},
  abstract = {The ocean Internet of Things (OIoT) has promoted the development of ocean devices, which generate a large amount of underwater acoustic data. The transmission of underwater acoustic data requires a large amount of spectrum resources. Aiming at the problems of improving the utilization rate and security of spectrum resources, an underwater acoustic spectrum sensing algorithm based on personalized federated learning (PFL) and RepViG is proposed. A security protection framework is established for underwater acoustic data based on PFL. The common features of each underwater acoustic data are extracted through the meta-model. Each client only needs to fine-tune the parameters of the meta-model based on the local underwater acoustic data to achieve a personalized model. Based on the improved RepViT and the improved ViG, a dual-branch sensing model of RepViG is designed. In the improved RepViT, we employ the Haar wavelet downsampling (HWD) module to retain the low-frequency and high-frequency detail features of the underwater acoustic signal through multiresolution. And we employ an interactive convolution block (ICB) to capture the relationship between local features and global features through multiscale dynamic convolution kernels. In the improved ViG, we adopt the lightweight Star-Block module to reduce feature redundancy and enhance sensing efficiency. Compared with other algorithms, the simulation results show that the detection probability is increased by 7.6},
  langid = {english},
  keywords = {Accuracy,Adaptation models,Convolution,Data models,Feature extraction,Feature fusion,Internet of Things,meta-learning,ocean Internet of Things (OIoT),Oceans,personalized federated learning (PFL),Security,Sensors,underwater acoustic spectrum sensing,Underwater acoustics}
}

@article{11320562,
  title = {Efficient Collision-Free Data Collection for Underwater Acoustic Sensor Networks: {{A}} Hierarchical {{DRL}} Approach},
  shorttitle = {Efficient Collision-Free Data Collection for Underwater Acoustic Sensor Networks},
  author = {Chen, Hao and Guo, Jiani and Zhang, Bowen and Song, Shanshan and Ye, Qiang and Pan, Miao},
  year = 2026,
  month = jun,
  journal = {IEEE Transactions on Mobile Computing},
  volume = {25},
  number = {6},
  pages = {8876--8891},
  issn = {1536-1233, 1558-0660, 2161-9875},
  doi = {10.1109/TMC.2025.3649541},
  abstract = {Autonomous underwater vehicles (AUVs) have become a promising solution for data collection in underwater acoustic sensor networks (UASNs), and deep reinforcement learning (DRL) has been widely applied to enhance collection performance. However, our preliminary experiments indicate that existing DRL-based studies still face two critical challenges: 1) Collection blind spots. The sparse collection rewards and the requirement for energy-efficient trajectory planning during data collection jointly restrict AUVs' ability to explore and collect data from all sensor nodes (SNs), ultimately resulting in some SNs remaining uncollected. 2) Collection collisions. Simultaneous data collection by multiple AUVs can lead to packet collisions and collection failures, further decreasing the collection rate. To address these challenges, we propose a hierarchical DRL-based collision-free data collection scheme (HCDC). Specifically, we leverage a hierarchical DRL framework to decompose the multi-AUV-assisted data collection (MADC) problem into a high-level global target selection (GTS) and a low-level local trajectory planning (LTP) subproblems. For GTS, we design a multi-agent GTS (MA-GTS) algorithm to assign the next target SN for collection to each AUV. The MA-GTS incorporates both global and local rewards to collaboratively optimize the overall energy consumption while avoiding individual penalties. Based on the assigned target SN, a deep deterministic policy gradient-based LTP (DDPG-LTP) algorithm is proposed to conduct AUV trajectory planning, utilizing intrinsic rewards to enhance learning efficiency and eliminate collection blind spots. Furthermore, to avoid packet collisions, we analyze the conditions for collision-free data collection and propose an adaptive back-off slot (ABS) algorithm to schedule AUVs' collection slots. With the collision-free slots, DDPG-LTP dynamically adjusts AUVs' velocities to ensure collision-free collection while reducing energy consumption. Extensive simulation results demonstrate that HCDC can achieve better collection rate and energy efficiency than state-of-the-art schemes.},
  langid = {english},
  keywords = {collision-free,data collection,Data collection,Energy consumption,Energy efficiency,Heuristic algorithms,Oceans,Resource management,Schedules,Trajectory,trajectory planning,Trajectory planning,Underwater acoustic sensor networks,Underwater acoustics}
}

@article{11348964,
  title = {Efficient Anadromic Gradient Descent-Based off-Grid Underwater Acoustic Channel Estimation for Long-Term {{IoUT}} Systems},
  author = {Dong, Bowen and Men, Wei and Han, Xiao and Yin, Jingwei and Niyato, Dusit},
  year = 2026,
  month = mar,
  journal = {IEEE Internet of Things Journal},
  volume = {13},
  number = {6},
  pages = {12359--12374},
  issn = {2327-4662, 2372-2541},
  doi = {10.1109/JIOT.2026.3653677},
  abstract = {Underwater acoustic communication (UAC) is one of the core technologies for the Internet of Underwater Things (IoUT). Channel estimation (CE) is crucial for achieving reliable UAC performance. However, existing underwater acoustic CE methods involve a tradeoff between computational overhead and estimation accuracy. To relieve this issue, this article proposes an efficient and high-precision CE algorithm. Based on compressed sensing (CS) theory, the algorithm first obtains an on-grid delay estimate via orthogonal matching pursuit (OMP). Subsequently, we optimize the delay estimation result beyond the grid constraint using an anadromic gradient descent (AGD) algorithm combined with the Armijo backtracking line search approach. The simulation results demonstrate that the proposed AGD-Armijo algorithm achieves comparable CE performance to existing same type of off-grid (OG) CE algorithms, while improving the iterative convergence rate by approximately 52.7},
  langid = {english},
  keywords = {Anadromic gradient descent (AGD),Approximation algorithms,Channel estimation,Convergence,Estimation,Internet of Underwater Things (IoUT),Iterative algorithms,Matching pursuit algorithms,OFDM,off-grid (OG) channel estimation (CE),Optimization,orthogonal matching pursuit (OMP),underwater acoustic,Underwater acoustics,Vectors}
}

@article{11373737,
  title = {Simplified Channel Model for Medium- and Long-Range Underwater Electromagnetic Communication in Nonhomogeneous Seawater},
  author = {Wang, Honglei and Ren, Yingda and Wei, Yulong},
  year = 2026,
  month = mar,
  journal = {IEEE Sensors Journal},
  volume = {26},
  number = {6},
  pages = {9285--9299},
  issn = {1530-437X, 1558-1748, 2379-9153},
  doi = {10.1109/JSEN.2026.3660132},
  abstract = {With the continuous advancement of ocean observation technologies, ocean information sensing networks have evolved beyond traditional underwater sensors and are gradually expanding into multidimensional observation systems that incorporate aerial nodes. To enable effective collaboration among multiple nodes, efficient information exchange is essential. Underwater electromagnetic communication (UEMC) plays a vital role in ocean observation networks as a key means of data transmission. However, due to the nonuniformity of electromagnetic (EM) parameters in the real marine environment and the need for wide-area observational network coverage, accurate channel modeling for medium- and long-range UEMC is required in nonhomogeneous seawater. Traditional channel modeling techniques based on propagation models frequently require solving the Sommerfeld integral, which results in increased modeling complexity and high computational cost. Moreover, this reliance restricts the physical interpretability and practical application of the model. To address these limitations, a simplified channel model for medium- and long-range UEMC in nonhomogeneous seawater is proposed. The model is extended from the UEMC channel in homogeneous seawater, explicitly accounting for the impact of spatial variations in seawater EM parameters on absorption loss and transmission attenuation. Numerical simulations demonstrate good agreement between the proposed model and the reference model obtained based on the propagation model. In addition, compared to the reference model, the simplified model achieves significantly higher computational efficiency, and its performance remains stable regardless of changes in horizontal distance, operating frequency, or the number of seawater layers. Moreover, the simplified model demonstrates an explicit relationship between environmental and communication parameters and channel characteristics, which provides a theoretical foundation for the deployment and parameter optimization of communication systems.},
  langid = {english},
  keywords = {Attenuation,Channel model,Channel models,Computational modeling,Conductivity,cross-interface communication,frequency-domain response,Intelligent sensors,nonhomogeneous seawater,Numerical models,Optical sensors,path loss,Reflection,Sea surface,Surface waves,underwater communication}
}

@article{11457814,
  title = {Underwater Acoustic Channel Replay Based on Singular Value Decomposition and Autoregressive Model},
  author = {Liu, Biao and Jia, Ning and Huang, Jianchun and Wang, Biao and Guo, Shengming and Fang, Tao and You, Yong},
  year = 2026,
  month = apr,
  journal = {IEEE Journal of Oceanic Engineering},
  volume = {51},
  number = {2},
  pages = {1474--1492},
  issn = {0364-9059, 1558-1691, 2373-7786},
  doi = {10.1109/JOE.2026.3671482},
  abstract = {The underwater acoustic channel replay method effectively captures the effects of marine environments, enabling the performance evaluation of underwater acoustic communication technologies and algorithms. To avoid the complexity of describing correlated scattering paths, the time-varying transfer function is used for replay and efficiently decomposed into principal and random components using singular value decomposition. This decomposition requires a single estimation of the decomposition order, determined by the minimum description length criterion. By regenerating random components with different sets of singular values, various time-varying underwater acoustic channels are obtained. Subsequently, autoregressive (AR) models are established for the principal and random components, yielding model parameters such as coefficients, poles, and complex Gaussian noise terms. Using the inverse process of the AR model with interpolated parameters, a time-varying underwater acoustic channel can be replayed. Compared with the traditional time-domain interpolation of time-varying impulse responses, the proposed method enables the replay of time-varying multipath cluster delays and generates replayed channels with better temporal correlation that more closely align with the original measured channels. The effectiveness of the proposed replay method is validated by comparing channel properties and communication simulation results between the original channel and replayed channels generated via different methods. Specifically, the time-varying channel properties derived using the local scattering function demonstrate that the channel generated using the proposed method exhibits time--frequency variations and statistical distributions that closely match those of the original channel.},
  langid = {english},
  keywords = {Acoustic measurements,Acoustic propagation,Data models,Delays,Local scattering function (LSF),Matrix decomposition,modeling and simulation,Radio communication,Scattering,Sea measurements,sound propagation and scattering,Sound recognition,Stochastic processes,Time-domain analysis,Time-varying channels,underwater acoustic channel replay,Underwater acoustics,Underwater communication,underwater radio communications}
}

@inproceedings{11460927,
  title = {Adaptive Metaheuristic-Optimized Stochastic Resonance Network for {{DOA}} Estimation in Low-{{SNR}} Underwater Environments},
  booktitle = {{{ICASSP}} 2026 - 2026 {{IEEE International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}} ({{ICASSP}})},
  author = {Zhang, Tong and Liu, Jun and Zou, Zhuoya},
  year = 2026,
  month = may,
  pages = {19607--19611},
  issn = {2379-190X},
  doi = {10.1109/ICASSP55912.2026.11460927},
  abstract = {Accurate direction of arrival (DOA) estimation in low signal-to-noise ratio (SNR) underwater environments is crucial for acoustic applications. Traditional stochastic resonance (SR) methods are limited by fixed parameters and phase distortion. This paper proposes an adaptive metaheuristic-optimized SR network (AMO-SRN) that enhances signal detection while preserving phase consistency. An improved piecewise potential function overcomes nonlinear saturation, a phase consistency-preserving fitness function maximizes output SNR, and adaptive parameter tuning ensures real-time noise matching. Simulations demonstrate the accuracy advantage of proposed method compared to MUSIC and learning-based method for complex underwater DOA estimation.},
  langid = {english},
  keywords = {5G mobile communication,Biomimetics,Communication systems,direction of arrival (DOA) estimation,HTTP,Location awareness,Massive machine type communications,metaheuristic optimization,Mobile communication,Protocols,stochastic resonance (SR),System-on-chip,Telecommunication services,Underwater acoustic signal processing}
}

@article{11493649,
  title = {Delay-Doppler Domain Channel Measurements and Modeling in High-Speed Railways},
  author = {Zhou, Hao and Ma, Yiyan and Fei, Dan and Liu, Weirong and Zhang, Zhengyu and Yang, Mi and Ma, Guoyu and Lu, Yunlong and He, Ruisi and Wang, Guoyu and Li, Cheng and Song, Zhaohui and Ai, Bo},
  year = 2026,
  journal = {IEEE Transactions on Wireless Communications},
  volume = {25},
  pages = {15725--15740},
  issn = {1536-1276, 1558-2248},
  doi = {10.1109/TWC.2026.3684101},
  abstract = {As next-generation wireless communication systems need to be able to operate in high-frequency bands and high-mobility scenarios, delay-Doppler (DD) domain multicarrier (DDMC) modulation schemes, such as orthogonal time frequency space (OTFS), demonstrate superior reliability over orthogonal frequency division multiplexing (OFDM). Accurate DD domain channel modeling is essential for DDMC system design. However, since traditional channel modeling approaches are mainly confined to time, frequency, and space domains, the principles of DD domain channel modeling remain poorly studied. To address this issue, we propose a systematic DD domain channel measurement and modeling methodology in high-speed railway (HSR) scenarios. First, we design a DD domain channel measurement method based on the long-term evolution for railway (LTE-R) system. Second, for DD domain channel modeling, we investigate quasi-stationary interval, statistical power modeling of multipath components, and particularly, the quasi-invariant intervals of DD domain channel fading coefficients. Third, via LTE-R measurements at 371 km/h, taking the quasi-stationary interval as the decision criterion, we establish DD domain channel models under different channel time-varying conditions in HSR scenarios. Fourth, the accuracy of proposed DD domain channel models is validated via bit error rate comparison of OTFS transmission. In addition, simulation verifies that in HSR scenario, the quasi-invariant interval of DD domain channel fading coefficient is on millisecond (ms) order of magnitude, which is much smaller than the quasi-stationary interval length on 100 ms order of magnitude. This study could provide theoretical guidance for DD domain modeling in high-mobility environments, supporting future DDMC and integrated sensing and communication designs for 6G and beyond.},
  langid = {english},
  keywords = {Antennas,Antennas and propagation,Artificial satellites,Communication systems,delay-Doppler domain channel modeling,Filtering,Filters,High-speed railway,Low earth orbit satellites,Modulation,OFDM,orthogonal time frequency space,Receiving antennas}
}

@article{11517574,
  title = {A Deep Learning-Based Green and Highly Reliable Underwater Bionic Communication Method},
  author = {Jiang, Jiaming and Wang, Jingjing and Shi, Wei and Luan, Wenhui and Wang, Meng},
  year = 2026,
  journal = {IEEE Transactions on Green Communications and Networking},
  volume = {10},
  pages = {3102--3117},
  issn = {2473-2400},
  doi = {10.1109/TGCN.2026.3693088},
  abstract = {Traditional underwater acoustic communication poses challenges to the stability of the marine ecological balance. This paper proposes a green, highly reliable underwater bionic communication method based on deep learning. By simulating marine mammal vocalizations as information carriers, it achieves environmentally sustainable and highly reliable underwater communication. First, we employ discrete wavelet multiresolution decomposition to analyze the structural features of vocalizations, extracting the fourth-level low-frequency component---which exhibits stronger fading resistance and robustness---as the communication carrier. Subsequently, a bionic generative adversarial network was designed. Comprising an encoder, decoder, and discriminator, this architecture achieves accurate information embedding and reliable decoding through collaborative modeling of multi-layer features in both time and frequency domains. During model training, the deep deterministic policy gradient algorithm was incorporated to enhance the model's adaptability across varying channel conditions. Experimental results demonstrate that at a signal-to-noise ratio of 15 dB, the decoding error rates of all four bionic signals remain below 2.1\texttimes 10{$^{-4}$} when operating at an information embedding rate of 20 bit/s. This confirms the proposed method's capability to achieve highly reliable communication under low ecological disturbance.},
  langid = {english},
  keywords = {Biomimetics,Bit error rate,Convolution,Decoding,Deep learning,Error analysis,Frequency,green communication,marine mammals,Modeling,Optimization,Timing,Training,underwater bionic communication}
}

