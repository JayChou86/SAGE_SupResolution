@inproceedings{yanAnalysisModelingTimeVarying2025,
  title = {Analysis and Modeling of Time-Varying Multipath Amplitude in High-Speed Mobile Underwater Acoustic Channels},
  booktitle = {{{OCEANS}} 2025 {{Brest}}},
  author = {Yan, Honglu and Liu, Songzuo and Pan, Chenyu and Adil, Muhamamd and Qiao, Gang},
  year = 2025,
  month = jun,
  pages = {1--6},
  doi = {10.1109/OCEANS58557.2025.11104297},
  abstract = {In underwater acoustic communication (UAC), channels are typically assumed to be stationary or slowly time-varying during short communication events, with a single statistical distribution generally sufficient to describe path amplitude variation. However, our UAC channel measurements in high-speed mobile scenarios reveal the limitations of traditional single-state fading models and wide-sense stationary assumptions. The measured time-varying impulse responses (TVIR) demonstrate that rapid changes in propagation distance and environment lead to three non-stationary time-varying characteristics: line-of-sight (LOS) propagation loss related to relative movement distance, shadowing-induced average level fluctuations, and rapid oscillations due to scattering paths superposition. To characterize these dynamic properties and enable realistic time-varying multipath simulation, we propose a multiscale amplitude fading model based on finite state Markov chains (FSMCs). To validate the effectiveness of the proposed amplitude simulation model, comparative analyses are conducted with classical wireless mobile channel fading models, including Rician, lognormal, and Nakagami-m distributions. Evaluation metrics involved time-domain envelope and autocorrelation functions. The results indicate that our model effectively captures the dynamic trends of UAC channels in high-speed mobile scenarios.},
  langid = {english},
  keywords = {Acoustic measurements,Analytical models,channel modeling,Fading channels,Fluctuations,high-speed mobile,Market research,multipath amplitude,multiscale fading,non-stationary channel,Rician channels,Stochastic processes,Time-domain analysis,underwater acoustic propagation,Underwater acoustics,Wireless communication}
}

@article{yangUnderwaterAcousticOTFS2026,
  title = {Underwater Acoustic {{OTFS}} with Nonuniform Doppler Shifts: Modeling and off-Grid Block-Sparse Channel Estimation Algorithm},
  shorttitle = {Underwater Acoustic {{OTFS}} with Nonuniform Doppler Shifts},
  author = {Yang, Yang and Ma, Lu and Liu, Songzuo and Qiao, Gang and Song, Yang and Li, Tong},
  year = 2026,
  month = jan,
  journal = {IEEE Journal of Oceanic Engineering},
  volume = {51},
  number = {1},
  pages = {641--658},
  issn = {0364-9059, 1558-1691, 2373-7786},
  doi = {10.1109/JOE.2025.3599256},
  abstract = {Orthogonal time frequency space (OTFS) modulation, as a 2-D delay-Doppler (DD) domain technique, shows promising potential for underwater mobile communications. However, a critical challenge emerges in wideband underwater acoustic (UWA) channels where each propagation path exhibits a distinct Doppler factor. These Doppler factors result in frequency-dependent nonuniform shifts across the signal bandwidth, which persist as residual Doppler factors effects even after time-domain resampling compensation. This study investigates the impact of nonuniform Doppler shifts in UWA OTFS systems. A novel systematic derivation of the DD domain input--output relationship for UWA-OTFS systems is presented, incorporating residual Doppler effects. Furthermore, we derive a closed-form mathematical model for Doppler spreading in the DD domain and prove the block-sparse properties of UWA-OTFS. Based on the Doppler spreading model, a channel estimation algorithm combining off-grid block-sparse orthogonal matching pursuit with maximum likelihood estimation is proposed to improve Doppler resolution accuracy. Performance evaluation through comprehensive numerical simulations and experimental trials demonstrates the efficacy of the proposed channel estimation algorithm. The superiority of OTFS over orthogonal frequency-division multiplexing in underwater mobile communications is also demonstrated.},
  langid = {english},
  keywords = {Accuracy,Block-sparse channel estimation,Channel estimation,Doppler effect,Doppler shift,Estimation,input-output relationship,Matching pursuit algorithms,Mathematical models,nonuniform Doppler,OFDM,orthogonal time frequency space (OTFS),underwater acoustic (UWA) communication,Underwater acoustics,Vectors}
}

@article{yanHighSpeedMobileUnderwater2026,
  title = {High-Speed Mobile Underwater Acoustical Communication Channel Measurement and Modeling},
  author = {Yan, Honglu and Liu, Songzuo and Pan, Chenyu and Kuang, Biao and Qiao, Gang},
  year = 2026,
  month = jan,
  journal = {IEEE Journal of Oceanic Engineering},
  volume = {51},
  number = {1},
  pages = {622--640},
  issn = {0364-9059, 1558-1691, 2373-7786},
  doi = {10.1109/JOE.2025.3632124},
  abstract = {Underwater acoustical communication (UAC) systems typically presume limited platform mobility, with insufficient attention to challenging high-speed mobile (HSM) scenarios. However, its importance is expected to increase with the rapid development of highly maneuverable autonomous underwater vehicles. Knowledge of HSM-UAC channels is a prerequisite for ensuring reliable communication links. This study conducts two shallow-water channel measurements with speeds up to 15 knots, involving both variable-speed and constant-speed horizontal motion. Measured time-varying impulse responses clearly reveal time-varying, multiscale, multilag (TV-MSML) phenomena. Based on these findings, we propose a TV-MSML channel model and use geometric acoustics theory and BELLHOP simulation to explain the observed phenomena and validate the model. We further analyze the time-varying behavior of multipath parameters, such as path delay, residual Doppler factor, and amplitude, and evaluate the applicability of conventional statistical distribution models in HSM scenarios. The nonstationary behavior of HSM-UAC channels is examined through frequency-selective fading, multipath birth--death processes, and spatiotemporal correlation. We designed a local stationarity distance metric using the temporal power correlation coefficient and compared various property parameters with static environments. This work alleviates the lack of measured data and characteristic studies on HSM-UAC channels, highlights the TV-MSML phenomena and high dynamism in HSM scenarios, and offers insights for designing and optimizing mobile UAC systems.},
  langid = {english},
  keywords = {Acoustic measurements,Analytical models,Channel estimation,Channel measurement,channel modeling,Delays,Doppler effect,Lakes,mobile underwater acoustical communication (UAC),multiscale multilag (MSML),nonstationary channel,Receivers,Sea measurements,Spatiotemporal phenomena,Wideband}
}

@inproceedings{yanStatisticalAnalysisTimevarying2021,
  title = {Statistical Analysis of Time-Varying Channel for Underwater Acoustic Communication and Network},
  booktitle = {2021 {{International Conference}} on {{Frontiers}} of {{Information Technology}} ({{FIT}})},
  author = {Yan, Honglu and Ma, Tianlong and Pan, Chenyu and Liu, Yanan and Liu, Songzuo},
  year = 2021,
  month = dec,
  pages = {55--60},
  doi = {10.1109/FIT53504.2021.00020},
  abstract = {The spatial-temporal random variation characteristics of underwater acoustic channel make the difference among the underwater acoustic communication network link channels, which make network performance difficult to predict. In order to better understand the fluctuation and difference of network link channel, we analyze the measured channel data of five links in the Qiandao Lake underwater acoustic communication network experiment. This paper first estimates impulse response, spread function, power delay profile and Doppler power spectrum of the time-varying channel in a short detection time, and compares the time-frequency energy distribution characteristics of each link channel. Then, we statistically analyze the discreteness of the signal to noise ratio, multipath spread and Doppler spread parameter distributions for a total of145 channels over a long observation period. The results show that energy distribution structure and fading fluctuation scale of each link channel in underwater acoustic communication network are obviously different.},
  langid = {english},
  keywords = {Acoustic measurements,Communication networks,Fading channels,fading fluctuation,Fluctuations,Time measurement,Time-frequency analysis,Time-varying channels,time-varying difference,underwater acoustic channel measurement,Underwater acoustic communication network}
}

