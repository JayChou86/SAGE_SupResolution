@inproceedings{wangUnsupervisedRadialBasis2025,
  title = {Unsupervised Radial Basis Function Neural Network Based Adaptive Chromaticity Drift Mitigation in Uniform Colour Space for Display Camera Communications},
  booktitle = {2025 {{IEEE}} 25th {{International Conference}} on {{Communication Technology}} ({{ICCT}})},
  author = {Wang, Zhe and Su, Yue and Zou, Dezhi and Li, Song and Liu, Songzuo},
  year = 2025,
  month = oct,
  pages = {1509--1513},
  issn = {2576-7828},
  doi = {10.1109/ICCT67417.2025.11374284},
  abstract = {Display camera communication (DCC) faces critical challenges in balancing resilient data embedding and perceptual fidelity preservation during dynamic video streaming scenarios. Under the joint L\textasciicircum\textbackslash ast a\textasciicircum\textbackslash ast b\textasciicircum\textbackslash ast constraints for adaptive grid cell (GC) enabling over video frames, chroma-based interframe Manchester encoding (CIME) is employed to seamlessly integrate the bit stream into video stream. For camera reception side, interframe nonlinear chrominance drift (NCD) across optical imaging channels over the chrominance plane significantly degrades the decoding performance for chromaticity-based data embedding. To address the issue of NCD, we propose a Delta-frame Hue-angle-based clustering (DHC) approach, followed by an unsupervised radial basis function-based neural network (RBFNN) framework, to effectively mitigate NCD. Experimental results demonstrate that the joint DHC-RBFNN framework can effectively reduces the system bit-error-rate (BER) by more than 50\%, with a Q-factor improvement ranging from 1.59 to 2.67 dB.},
  langid = {english},
  keywords = {Cameras,differential Manchester encoding,Encoding,Image color analysis,Machine learning,nonlinear chrominance drift,Optical camera communications,Optical imaging,Q-factor,radial basis function,Radial basis function networks,Streaming media,System performance,unsupervised machine learning,Videos}
}

