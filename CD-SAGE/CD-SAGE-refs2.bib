}

@article{maNovelNonstationaryGeometrybased2025,
  title = {A Novel Nonstationary Geometry-Based Stochastic Model for Underwater Acoustic {{MIMO}} Communication Systems in Shallow Seas},
  author = {Ma, Yilin and Wang, Cheng-Xiang and Chang, Hengtai and Huang, Jie and Wang, Jun and An, Liang and Chen, Yunfei},
  year = 2025,
  month = oct,
  journal = {IEEE Internet of Things Journal},
  volume = {12},
  number = {20},
  pages = {41713--41726},
  issn = {2327-4662, 2372-2541},
  doi = {10.1109/JIOT.2025.3591731},
  urldate = {2026-06-29},
  abstract = {underwater acoustic (UWA) channel models are indispensable for the design of UWA communication systems and technologies. In this article, a novel nonstationary 3-D twin cluster geometry-based stochastic model (GBSM) is proposed for multiple-input--multiple-output (MIMO) UWA communication systems in shallow seas. The distribution of nonline-of-sight (NLoS) delays obeys the Nakagami distribution in this model according to the results generated by Bellhop. In addition, the relationship between delay and power is modeled as a negative exponential distribution with different parameters for each NLoS component. The periodic mobility of clusters and distribution of scatterers, caused by the fluctuations of sea surface, are considered to account for the unique UWA environment. Channel statistical properties, such as the space--time--frequency correlation function (STFCF), Doppler power spectrum density (PSD), Doppler spread, coherence time, and coherence distance, are investigated. In particular, temporal autocorrelation function (TACF) and frequency correlation function (FCF) are compared with measurement data to validate the accuracy of this model. Simulation results show that the fluctuating sea surface can cause significant changes in UWA channel characteristics, making it indispensable in channel modeling.},
  langid = {english},
  keywords = {3-D geometry-based stochastic model (GBSM),Computational modeling,Delays,fluctuating sea surface,Internet of Things,Mathematical models,nonstationarity,Reflection,Scattering,Sea measurements,Sea surface,shallow seas,Sonar,Three-dimensional displays,underwater acoustic (UWA) channels},
  file = {F\:\\Program\\ZoteroData\\storage\\3GGV2PBQ\\Ma 等 - 2025 - A novel nonstationary geometry-based stochastic model for underwater acoustic MIMO communication sys.no_watermark.zh-CN.dual.pdf;F\:\\Program\\ZoteroData\\storage\\JIZTKHIU\\Ma 等 - 2025 - A novel nonstationary geometry-based stochastic model for underwater acoustic MIMO communication sys.pdf;F\:\\Program\\ZoteroData\\storage\\N7WSK2JF\\Ma 等 - 2025 - A novel nonstationary geometry-based stochastic model for underwater acoustic MIMO communication sys.no_watermark.zh-CN.mono.pdf}
